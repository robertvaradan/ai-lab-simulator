[sub_resource type="Resource" id="Resource_player_evaluations"]
script = ExtResource("8_evaluation")
coding_evaluation_points = 72
reasoning_evaluation_points = 70
efficiency_evaluation_points = 76

[sub_resource type="Resource" id="Resource_player_model"]
script = ExtResource("7_model")
stable_id = &"model.player.starting"
display_name = "Aperture"
version_label = "1.0"
release_state_id = &"model_release_state.released"
release_strategy_id = &"release_strategy.commercial_api"
evaluations = SubResource("Resource_player_evaluations")
training_compute_unit_months = 90
inference_compute_unit_months_per_contract = 2

[sub_resource type="Resource" id="Resource_research_plot"]
script = ExtResource("6_plot")
stable_id = &"plot.campus.research"
state_id = &"site_plot_state.compact_lab"

[sub_resource type="Resource" id="Resource_compute_link_plot"]
script = ExtResource("6_plot")
stable_id = &"plot.campus.compute_link"
state_id = &"site_plot_state.no_link"

[sub_resource type="Resource" id="Resource_product_plot"]
script = ExtResource("6_plot")
stable_id = &"plot.campus.product"
state_id = &"site_plot_state.product_studio"

[sub_resource type="Resource" id="Resource_company_site"]
script = ExtResource("5_site")
stable_id = &"site.company.sf_campus"
site_plots = {
&"plot.campus.compute_link": SubResource("Resource_compute_link_plot"),
&"plot.campus.product": SubResource("Resource_product_plot"),
&"plot.campus.research": SubResource("Resource_research_plot")
}

[sub_resource type="Resource" id="Resource_standard_compute_contract"]
script = ExtResource("9_contract")
stable_id = &"contract.compute.standard"
content_definition_id = &"contract.compute.standard"
status_id = &"contract_state.active"

[sub_resource type="Resource" id="Resource_company"]
script = ExtResource("4_company")
sites = {
&"site.company.sf_campus": SubResource("Resource_company_site")
}
staff_person_count = 40
project_team_count = 2
compute_capacity_unit_months = 70
fixed_operating_cost_musd_per_month_step = 5
projects = {}
models = {
&"model.player.starting": SubResource("Resource_player_model")
}
applications = {}
contracts = {
&"contract.compute.standard": SubResource("Resource_standard_compute_contract")
}
public_trust_points = 55
government_trust_points = 50

[sub_resource type="Resource" id="Resource_northstar"]
script = ExtResource("11_competitor")
stable_id = &"competitor.northstar"
stage_id = &"competitor_stage.northstar.announced"

[sub_resource type="Resource" id="Resource_technical_frontier"]
script = ExtResource("8_evaluation")
coding_evaluation_points = 74
reasoning_evaluation_points = 72
efficiency_evaluation_points = 74

[sub_resource type="Resource" id="Resource_coding_agent_market"]
script = ExtResource("12_market")
stable_id = &"market.coding_agent"
possible_customer_contract_count = 12
customer_expectation_coding_evaluation_points = 70
reference_price_musd_per_contract_month = 1

[sub_resource type="Resource" id="Resource_world"]
script = ExtResource("10_world")
competitors = {
&"competitor.northstar": SubResource("Resource_northstar")
}
models = {}
technical_frontier = SubResource("Resource_technical_frontier")
markets = {
&"market.coding_agent": SubResource("Resource_coding_agent_market")
}
active_government_condition_ids = {}

[sub_resource type="Resource" id="Resource_calendar"]
script = ExtResource("3_calendar")
current_month_step_index = 0
current_quarter_index = 1
phase_id = &"calendar_state.planning"

[sub_resource type="Resource" id="Resource_cash_ledger"]
script = ExtResource("13_ledger")
stable_id = &"ledger.cash.company"
opening_balance_musd = 150
transactions = []

[sub_resource type="Resource" id="Resource_runtime_id_counters"]
script = ExtResource("15_counters")
next_sequence_by_entity_type = {
&"application": 1,
&"command": 1,
&"command_batch": 1,
&"contract": 1,
&"event": 1,
&"ledger_transaction": 1,
&"model": 1,
&"notification": 1,
&"project": 1
}

[sub_resource type="Resource" id="Resource_starting_game_state"]
script = ExtResource("2_game")
schema_version = 2
content_version = 1
rule_graph_id = &"rule_graph.marketing.first_quarter"
rule_graph_version = 1
scenario_id = &"scenario.marketing.first_quarter"
calendar = SubResource("Resource_calendar")
company = SubResource("Resource_company")
world = SubResource("Resource_world")
cash_ledger = SubResource("Resource_cash_ledger")
pending_command_batch = null
attention_events = []
notifications = []
random_generator_state = null
runtime_id_counters = SubResource("Resource_runtime_id_counters")

[sub_resource type="Resource" id="Resource_project_research"]
script = ExtResource("16_project")
stable_id = &"project.research.frontier_model"
specification_reference = "docs/marketing/marketing-scenario.md"
schema_version = 2
start_cost_musd = 65
duration_month_steps = 3
reserved_project_teams = 1
reserved_compute_unit_months = 30
prerequisite_project_ids = Array[StringName]([])
required_payload_keys = Array[StringName]([&"project_id", &"model_display_name", &"model_version_label", &"release_strategy_id"])
completion_effect_id = &"project_completion.research_model"
completed_model_id = &"model.player.research_output"
completed_model_coding_evaluation_points = 84
completed_model_reasoning_evaluation_points = 79
completed_model_efficiency_evaluation_points = 80
completed_model_inference_compute_unit_months_per_contract = 2

[sub_resource type="Resource" id="Resource_project_scale"]
script = ExtResource("16_project")
stable_id = &"project.scale.burst_compute"
specification_reference = "docs/marketing/marketing-scenario.md"
schema_version = 2
start_cost_musd = 30
duration_month_steps = 1
reserved_project_teams = 1
reserved_compute_unit_months = 0
prerequisite_project_ids = Array[StringName]([])
required_payload_keys = Array[StringName]([&"project_id"])
completion_effect_id = &"project_completion.burst_compute"
completed_contract_id = &"contract.compute.burst"
completed_contract_compute_unit_months = 60

[sub_resource type="Resource" id="Resource_project_coding_agent"]
script = ExtResource("16_project")
stable_id = &"project.application.coding_agent"
specification_reference = "docs/marketing/marketing-scenario.md"
schema_version = 2
start_cost_musd = 40
duration_month_steps = 2
reserved_project_teams = 1
reserved_compute_unit_months = 10
prerequisite_project_ids = Array[StringName]([])
required_payload_keys = Array[StringName]([&"project_id", &"supporting_model_id"])
completion_effect_id = &"project_completion.coding_agent"
completed_application_id = &"application.player.coding_agent"
completed_application_price_musd_per_contract_month = 1

[sub_resource type="Resource" id="Resource_competitor_northstar"]
script = ExtResource("17_competitor_def")
stable_id = &"competitor.northstar"
specification_reference = "docs/marketing/marketing-scenario.md"
schema_version = 2
announced_stage_id = &"competitor_stage.northstar.announced"
released_stage_id = &"competitor_stage.northstar.flagship_released"
