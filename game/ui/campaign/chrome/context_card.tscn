[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://ui/campaign/chrome/context_card.gd" id="1_script"]

[node name="ContextCard" type="PanelContainer"]
custom_minimum_size = Vector2(320, 220)
theme_type_variation = &"ContextCard"
script = ExtResource("1_script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 16

[node name="Layout" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="Margin/Layout"]
layout_mode = 2

[node name="TitleLabel" type="Label" parent="Margin/Layout/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 18
text = "LABORATORY"

[node name="CloseButton" type="Button" parent="Margin/Layout/Header"]
custom_minimum_size = Vector2(40, 40)
layout_mode = 2
theme_type_variation = &"CloseAction"
flat = true

[node name="BodyLabel" type="Label" parent="Margin/Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
autowrap_mode = 3
text = ""

[node name="Rows" type="VBoxContainer" parent="Margin/Layout"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="PrimaryButton" type="Button" parent="Margin/Layout"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
theme_type_variation = &"PrimaryAction"
text = "OPEN PROJECTS"
