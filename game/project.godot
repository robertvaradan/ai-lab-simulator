; AI Lab Simulator render/pipeline foundation.
; Edit through Godot when possible; keep automated capture contracts in sync with README.md.

config_version=5

[application]

config/name="AI Lab Simulator"
run/main_scene="res://scenes/sdf_render_harness.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[debug]

gdscript/warnings/enable=true
gdscript/warnings/enum_variable_without_default=2
gdscript/warnings/incompatible_ternary=2
gdscript/warnings/inference_on_variant=2
gdscript/warnings/int_as_enum_without_cast=2
gdscript/warnings/int_as_enum_without_match=2
gdscript/warnings/unsafe_call_argument=2
gdscript/warnings/unsafe_cast=2
gdscript/warnings/unsafe_method_access=2
gdscript/warnings/unsafe_property_access=2
gdscript/warnings/unsafe_void_return=2
gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/size/resizable=false
window/size/no_focus=true
window/stretch/mode="canvas_items"

[filesystem]

import/blender/enabled=false

[rendering]

rendering_device/driver.windows="d3d12"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.045, 0.071, 0.09, 1)
