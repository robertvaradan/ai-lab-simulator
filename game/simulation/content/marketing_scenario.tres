known_release_quarter_index = 1
projected_coding_evaluation_min = 80
projected_coding_evaluation_max = 84
projected_reasoning_evaluation_min = 76
projected_reasoning_evaluation_max = 80
projected_efficiency_evaluation_min = 70
projected_efficiency_evaluation_max = 74
actual_coding_evaluation_points = 82
actual_reasoning_evaluation_points = 78
actual_efficiency_evaluation_points = 72
released_model_id = &"model.competitor.northstar.flagship"
released_model_display_name = "Northstar Flagship"
released_model_version_label = "1.0"
released_model_release_strategy_id = &"release_strategy.commercial_api"
released_model_training_compute_unit_months = 0
released_model_inference_compute_unit_months_per_contract = 0
customer_expectation_market_id = &"market.coding_agent"
released_customer_expectation_coding_evaluation_points = 80
release_event_id = &"event.competitor.northstar_flagship_release"

[sub_resource type="Resource" id="Resource_contract_standard"]
script = ExtResource("18_contract_def")
stable_id = &"contract.compute.standard"
specification_reference = "docs/marketing/marketing-scenario.md"
schema_version = 2
monthly_cost_musd = 4
ledger_category_id = &"cash_category.compute_contract.standard"

[sub_resource type="Resource" id="Resource_contract_burst"]
script = ExtResource("18_contract_def")
stable_id = &"contract.compute.burst"
specification_reference = "docs/marketing/marketing-scenario.md"
schema_version = 2
monthly_cost_musd = 8
ledger_category_id = &"cash_category.compute_contract.burst"

[resource]
script = ExtResource("1_scenario")
schema_version = 2
content_version = 1
rule_graph_id = &"rule_graph.marketing.first_quarter"
rule_graph_version = 1
stable_id = &"scenario.marketing.first_quarter"
difficulty_profile_id = &"difficulty.standard"
specification_reference = "docs/marketing/marketing-scenario.md"
starting_game_state = SubResource("Resource_starting_game_state")
available_project_ids = Array[StringName]([&"project.research.frontier_model", &"project.scale.burst_compute", &"project.application.coding_agent"])
project_definitions = Array[ExtResource("16_project")]([SubResource("Resource_project_research"), SubResource("Resource_project_scale"), SubResource("Resource_project_coding_agent")])
competitor_definitions = Array[ExtResource("17_competitor_def")]([SubResource("Resource_competitor_northstar")])
contract_definitions = Array[ExtResource("18_contract_def")]([SubResource("Resource_contract_standard"), SubResource("Resource_contract_burst")])
command_type_ids = Array[StringName]([&"command.project.start"])
content_reference_ids = Array[StringName]([&"difficulty.standard", &"calendar_state.planning", &"contract.compute.standard", &"contract.compute.burst", &"contract_state.active", &"model_release_state.released", &"release_strategy.commercial_api", &"site_plot_state.compact_lab", &"site_plot_state.no_link", &"site_plot_state.product_studio", &"competitor.northstar", &"competitor_stage.northstar.announced", &"competitor_stage.northstar.flagship_released", &"command.project.start", &"project.research.frontier_model", &"project.scale.burst_compute", &"project.application.coding_agent", &"project_status.active", &"project_status.completed", &"application_status.active", &"application.player.coding_agent", &"attention_event.quarter_boundary", &"notification.project.completed", &"cash_category.project.start", &"cash_category.operating_cost", &"cash_category.compute_contract.standard", &"cash_category.compute_contract.burst", &"cash_category.application.revenue"])
